# ============================================
# MSC SRPK v2.0 - Variables de Entorno
# ============================================
# Copiar a .env y configurar antes de desplegar:
#   cp .env.example .env
#   nano .env

# --- Entorno ---
MSC_SRPK_ENV=production
MSC_SRPK_LOG_LEVEL=INFO

# --- Web Server ---
MSC_SRPK_WEB_HOST=0.0.0.0
MSC_SRPK_WEB_PORT=8000

# --- Dominio (cambiar por tu dominio real) ---
DOMAIN=mscsrpk.com
EMAIL_ADMIN=admin@mscsrpk.com

# --- Seguridad (CAMBIAR OBLIGATORIAMENTE) ---
MSC_SRPK_MASTER_KEY=CAMBIAR-POR-UNA-CLAVE-SEGURA-DE-32-CARACTERES
MSC_SRPK_PRIVACY_SALT=CAMBIAR-POR-UN-SALT-UNICO-ALEATORIO
JWT_SECRET_KEY=CAMBIAR-POR-UN-JWT-SECRET-SEGURO

# --- Licenciamiento ---
MSC_SRPK_LICENSE_KEY=

# --- Cache ---
MSC_SRPK_CACHE_DIR=/app/cache
REDIS_URL=redis://redis:6379/0

# --- IA / Modelos ---
MSC_SRPK_MODEL=microsoft/codebert-base
MSC_SRPK_FORCE_CPU=true

# --- Monitoring (opcional) ---
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# --- Email transaccional (opcional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mscsrpk.com

# --- Stripe para pagos (opcional) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- CORS (dominios permitidos en producción) ---
CORS_ORIGINS=https://mscsrpk.com,https://www.mscsrpk.com
